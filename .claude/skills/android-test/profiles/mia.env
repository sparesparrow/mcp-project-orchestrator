# Profile for sparesparrow/mia (apps/android). Package is stable across debug/release.
PKG=cz.mia.app
MAIN_ACTIVITY=.MainActivity
REPO=sparesparrow/mia
CI_WORKFLOW=release.yml          # release assets carry mia-app-debug.apk + mia-app-debug-androidTest.apk
TABS="Dashboard Alerts Camera OBD LED Settings"
# Verified on moto g54 (Android 15): Dashboard shows "No telemetry data" without an OBD adapter.
scenario_dashboard() { ui_launch; ui_wait "Dashboard" 12 && ui_has "Citro" ; ui_shot dashboard; }
